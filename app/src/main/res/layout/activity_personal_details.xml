<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_background"
    tools:context=".activities.PersonalDetailsActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btn_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="29sp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:text="PersonalDetails"/>

            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:text="PersonalDetails"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" लिंग / Gender"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginTop="30dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/white"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/textinput_background_selector"            app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <AutoCompleteTextView
                    android:id="@+id/et_gender"
                    android:layout_width="match_parent"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" आयु / Age"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="5dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                app:boxBackgroundMode="none"
                android:background="@drawable/textinput_background_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_age"
                    android:layout_width="match_parent"
                    android:inputType="number"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="वैवाहिक स्थिति / Marital Status"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/white"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/textinput_background_selector"            app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <AutoCompleteTextView
                    android:id="@+id/et_maritalStatus"
                    android:layout_width="match_parent"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" लॉकडाउन के दौरान रह रहे हैं / During lockdown staying at"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="5dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                app:boxBackgroundMode="none"
                android:background="@drawable/textinput_background_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_duringLockdownStayingAt"
                    android:layout_width="match_parent"
                    android:inputType="text"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" राज्य  / State"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="5dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                app:boxBackgroundMode="none"
                android:background="@drawable/textinput_background_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_state"
                    android:layout_width="match_parent"
                    android:inputType="text"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="शिक्षा / Education"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/white"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/textinput_background_selector"            app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <AutoCompleteTextView
                    android:id="@+id/et_education"
                    android:layout_width="match_parent"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" नौकरी / Job"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="5dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                app:boxBackgroundMode="none"
                android:background="@drawable/textinput_background_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_jobPosition"
                    android:layout_width="match_parent"
                    android:inputType="text"
                    android:textColor="@drawable/textfield_text_color"
                    android:hint=""
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" नोकरी की प्रकृति / Nature of Job"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/white"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/textinput_background_selector"            app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <AutoCompleteTextView
                    android:id="@+id/et_jobNature"
                    android:layout_width="match_parent"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" लॉक डाउन के दौरान नौकरी की स्थिति / Job status during lockdown"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/white"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/textinput_background_selector"            app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <AutoCompleteTextView
                    android:id="@+id/et_jobStatusDuringLockdown"
                    android:layout_width="match_parent"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" मासिक आय (रुपये में) / Monthly Income (In Rs)"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="5dp"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                app:boxBackgroundMode="none"
                android:background="@drawable/textinput_background_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_monthlyIncome"
                    android:layout_width="match_parent"
                    android:inputType="number"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" क्या आपका कोई परिचित व्यक्ति कोरोना से संक्रमित / did your any known person get infected by corona?"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/white"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/textinput_background_selector"            app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <AutoCompleteTextView
                    android:id="@+id/et_knowCovidInfected"
                    android:layout_width="match_parent"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" क्‍या आप कोरोना वायरस से संक्रमित हुए हैं? / Are you infected from corona virus?"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/white"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/textinput_background_selector"            app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <AutoCompleteTextView
                    android:id="@+id/et_covidInfected"
                    android:layout_width="match_parent"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" क्या आपको या आपके परिवार को अवसाद / अन्य
मानसिक बीमारी का कोई पिछला इतिहास है? / Do you or your family have any previous history of depression/ other mental illness?"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/white"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/textinput_background_selector"            app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <AutoCompleteTextView
                    android:id="@+id/et_depressionHistory"
                    android:layout_width="match_parent"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" क्या आप किसी अन्य लंबी बीमारी की बीमारी से
पीड़ित हैं? / Are you suffering from any long treatment illness?"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/white"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/textinput_background_selector"            app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <AutoCompleteTextView
                    android:id="@+id/et_longIllness"
                    android:layout_width="match_parent"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text=" क्‍या आप योग / ध्यान का अभ्यास करते हैं? / Do you practice yoga / meditation?"
                android:textStyle="bold"
                android:layout_marginHorizontal="20dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_marginTop="5dp"
                android:layout_height="wrap_content"
                android:textColorHint="@color/white"
                app:boxStrokeColor="@android:color/transparent"
                app:boxStrokeWidth="0dp"
                app:hintEnabled="false"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/textinput_background_selector"            app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <AutoCompleteTextView
                    android:id="@+id/et_practiceYoga"
                    android:layout_width="match_parent"
                    android:hint=""
                    android:textColor="@drawable/textfield_text_color"
                    android:textColorHint="@android:color/darker_gray"
                    android:layout_height="wrap_content"
                    android:inputType="none"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/btn_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/skip"
                android:textColor="@android:color/holo_red_light"
                android:textStyle="bold"
                android:textSize="22sp"
                android:layout_marginTop="20dp"/>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmitDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit Details"
                android:background="@drawable/shape_button_rounded"
                android:layout_marginVertical="50dp"
                android:layout_marginHorizontal="40dp"
                android:textSize="22sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:textColor="@color/white"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>



</ScrollView>